DEBUG=True
SECRET_KEY=django-insecure-local-development-only

# Optional: separate base64url-encoded 32-byte Ed25519 seeds for both signers.
# If omitted, stable signing seeds are derived from SECRET_KEY.
FAMILY_CARD_SIGNING_PRIVATE_KEY=
VILLAGE_HEAD_SIGNING_PRIVATE_KEY=

# Leave DATABASE_URL empty for local SQLite.
# Use PostgreSQL locally only if you already have a database URL.
# DATABASE_URL=postgres://user:password@localhost:5432/onlinetest

DATABASE_SSL_REQUIRE=False
ALLOWED_HOSTS=.localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
